# The backend. Browsers reach it through this app's /v1 route.
API_URL="http://localhost:4000"
# The customer storefront, for "view in the shop" links.
NEXT_PUBLIC_STORE_URL="http://localhost:3000"

# Firebase web app (Project settings > General > Your apps) and the Cloud Messaging
# web push key. Leave empty to hide the notification controls.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
